# ShopTalk production environment — copy these into Coolify's
# Environment Variables for the compose resource (or a local .env file).
# Generate secrets with: openssl rand -hex 32

# --- Required ---
DB_PASSWORD=
DJANGO_SECRET_KEY=

# --- Django ---
# Your public hostname(s), comma-separated. Example: shoptalk.example.com
DJANGO_ALLOWED_HOSTS=
# Full https origins, comma-separated. Example: https://shoptalk.example.com
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# --- Optional ---
DB_NAME=shoptalk
DB_USER=postgres

# --- Assistant AI provider (default heuristic needs no key) ---
SHOP_TALK_AI_PROVIDER=heuristic
SHOP_TALK_AI_API_KEY=
SHOP_TALK_AI_BASE_URL=
SHOP_TALK_AI_MODEL=
# Speech-to-text fallback model on the same key/base (voice recordings
# the browser speech service fails to transcribe). Leave empty for the
# per-endpoint default: muse-voice-transcribe-1.0 on api.meta.ai,
# whisper-1 on OpenAI-compatible endpoints.
SHOP_TALK_AI_TRANSCRIBE_MODEL=
# --- Offline speech model (Vosk large, no key needed) ---
# Downloaded on the server at image build time, never bundled in git.
# Override only to pin a different already-downloaded model directory.
# VOSK_MODEL_PATH=/app/core/models/vosk-model-en-us-0.22
