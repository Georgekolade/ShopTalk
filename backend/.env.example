# Copy to .env and fill in. Never commit the real file.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=shoptalk
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SHOP_TALK_AI_PROVIDER=heuristic
# --- Reasoning model (pick ONE block, uncomment, fill in your key) ---
# Option A: Muse via the native Anthropic API.
# SHOP_TALK_AI_PROVIDER=anthropic
# SHOP_TALK_AI_API_KEY=[redacted]
# SHOP_TALK_AI_BASE_URL=https://api.anthropic.com/v1
# SHOP_TALK_AI_MODEL=claude-sonnet-4-20250514
# Option B: any OpenAI-compatible endpoint (OpenAI, Meta Llama API,
# Groq, DeepSeek, local Ollama, or Meta's Muse API if it exposes one —
# use the exact base URL and model id from that provider's docs).
# SHOP_TALK_AI_PROVIDER=llm
# SHOP_TALK_AI_API_KEY=[redacted]
# SHOP_TALK_AI_BASE_URL=https://api.llama.com/compat/v1
# SHOP_TALK_AI_MODEL=llama-3.3-70b-versatile

# --- Offline speech model (Vosk; no key needed) ---
# Directory holding the unpacked vosk-model-small-en-us-0.15 download.
# Defaults to backend/core/models/vosk-model-small-en-us-0.15 when unset.
# VOSK_MODEL_PATH=
